#!/bin/bash

# Ensure the script is run as root
if [ "$EUID" -ne 0 ]; then
  echo "Please run as root or using sudo."
  exit 1
fi

# 1. Gather current network information
echo "Available network interfaces:"
ip -br link show | grep -v lo

echo ""
read -p "Enter the CURRENT interface name (e.g., ens33): " OLD_NAME
read -p "Enter the NEW interface name (e.g., eth0): " NEW_NAME

# Get MAC address for the chosen interface
MAC_ADDR=$(ip link show "$OLD_NAME" | awk '/link\/ether/ {print $2}')

if [ -z "$MAC_ADDR" ]; then
    echo "Error: Could not find MAC address for interface $OLD_NAME"
    exit 1
fi

echo -e "\nTarget Interface: $OLD_NAME"
echo "MAC Address:      $MAC_ADDR"
echo "New Name:         $NEW_NAME"
read -p "Proceed with these settings? (y/n): " CONFIRM

if [ "$CONFIRM" != "y" ]; then
    echo "Aborted."
    exit 1
fi

# 2. Create custom udev rule
UDEV_FILE="/etc/udev/rules.d/70-custom-net.rules"
echo "Creating udev rule in $UDEV_FILE..."
echo "SUBSYSTEM==\"net\", ACTION==\"add\", DRIVERS==\"?*\", ATTR{address}==\"$MAC_ADDR\", NAME=\"$NEW_NAME\"" > "$UDEV_FILE"

# 3. Update NetworkManager configuration script
OLD_CONFIG="/etc/sysconfig/network-scripts/ifcfg-$OLD_NAME"
NEW_CONFIG="/etc/sysconfig/network-scripts/ifcfg-$NEW_NAME"

if [ -f "$OLD_CONFIG" ]; then
    echo "Updating NetworkManager configuration..."
    mv "$OLD_CONFIG" "$NEW_CONFIG"
    
    # Remove existing definitions if they exist
    sed -i '/^DEVICE=/d' "$NEW_CONFIG"
    sed -i '/^NAME=/d' "$NEW_CONFIG"
    sed -i '/^HWADDR=/d' "$NEW_CONFIG"
    
    # Append the updated configurations
    echo "DEVICE=$NEW_NAME" >> "$NEW_CONFIG"
    echo "NAME=$NEW_NAME" >> "$NEW_CONFIG"
    echo "HWADDR=$MAC_ADDR" >> "$NEW_CONFIG"
else
    echo "Warning: Configuration file $OLD_CONFIG not found. Skipping config update."
fi

echo -e "\nConfiguration complete! A system reboot is required to apply the changes safely."
read -p "Reboot now? (y/n): " REBOOT_NOW
if [ "$REBOOT_NOW" = "y" ]; then
    reboot
fi
